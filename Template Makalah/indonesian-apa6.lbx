\DeclareBibliographyStrings{%
  inherit          = {indonesian},
  revisededition   = {{Edisi\space Revisi}{edisi\space rev\adddot}},
  page             = {{Halaman}{{}hlm\adddot}},
  pages            = {{Halaman}{{}hlm\adddot}},
  on               = {{pada}{pada}},
  retrieved        = {{diakses}{diakses}},
  available        = {{tersedia}{tersedia}},
  from             = {{dari}{dari}},
  archivedat       = {{diarsipkan\space di}{diarsipkan\space di}},
  with             = {{bersama}{bersama}},
  reprintas        = {{dicetak\space ulang\space sebagai}{dicetak\space ulang\space sebagai}},
  reprintfrom      = {{dicetak\space ulang\space dari}{dicetak\space ulang\space dari}},
  reviewof         = {{tinjauan\space atas}{tinjauan\space atas}},
  paragraph        = {{\P}{\P}},
  paragraphs       = {{\P\P}{\P\P}},
  producer         = {{produser}{produser}},
  execproducer     = {{produser eksekutif}{produser eksekutif}},
  director         = {{sutradara}{sutradara}},
  writer           = {{penulis}{penulis}},
  mathesis         = {{Tesis\addabbrvspace Magister}{Tesis\addabbrvspace Magister}},
  phdthesis        = {{Disertasi\addabbrvspace Doktoral}{Disertasi\addabbrvspace Doktoral}},
  origyear         = {{karya\space asli\space diterbitkan}{karya\space asli\space diterbitkan}},
  typechair        = {{Ketua}{Ketua}},
  typechairs       = {{Ketua}{Ketua}},
  typevolume       = {{Penyunting\space Jilid}{Penyunt\adddotspace Jilid}},
  typevolumes      = {{Penyunting\space Jilid}{Penyunt\adddotspace Jilid}},
  typeseries       = {{Penyunting\space Seri}{Penyunt\adddotspace Seri}},
